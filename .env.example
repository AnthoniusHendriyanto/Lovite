# ByMean Environment Variables
# Copy this to .env.local and fill in your values

# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Domain ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_DOMAIN=bymean.id
# For local dev this is ignored; use localhost:3000/[slug] directly

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@bymean.id

# ─── Payment — Phase 4+ (Tripay) ─────────────────────────────────────────────
# Register at tripay.co.id first
# TRIPAY_API_KEY=
# TRIPAY_PRIVATE_KEY=
# TRIPAY_MERCHANT_CODE=
# TRIPAY_MODE=sandbox   # 'sandbox' | 'production'

# ─── Phase 5+ (Custom domain via Vercel API) ─────────────────────────────────
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=
